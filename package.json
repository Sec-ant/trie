{
  "name": "@sec-ant/trie",
  "description": "A simple Trie structure with wildcard support to match streams",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/trie.git"
  },
  "homepage": "https://github.com/Sec-ant/trie",
  "bugs": {
    "url": "https://github.com/Sec-ant/trie/issues",
    "email": "zzwu@zju.edu.cn"
  },
  "keywords": [
    "trie",
    "stream",
    "wildcard"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "dev": "vite",
    "lint": "biome lint .",
    "format:prettier": "prettier . --write",
    "format:biome": "biome format . --write",
    "format": "pnpm format:prettier && pnpm format:biome",
    "format:check": "prettier . --check && biome format .",
    "check": "biome check . && prettier . --check",
    "check:fix": "biome check --write . && prettier . --write",
    "type-check": "tsc --noEmit --emitDeclarationOnly false && tsc -p tsconfig.node.json && tsc -p tests/tsconfig.json",
    "prebuild": "pnpm check && pnpm type-check",
    "build": "vite build && tsc",
    "test": "vitest",
    "test:ci": "vitest run && pnpm test:browser",
    "test:node": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "browser": "playwright install chromium firefox",
    "test:package": "tsx scripts/check-package.ts",
    "bench": "tsx scripts/benchmark.ts",
    "prepublishOnly": "pnpm build && pnpm test:ci && pnpm test:package",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "just-clone": "^6.2.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@12.15.0"
}
